# === Slack App ===
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=

# === Persistent storage (Vercel / Neon) ===
# Vercel MarketplaceでNeonを接続するとDATABASE_URLは自動設定されます。
DATABASE_URL=
# openssl rand -base64 32 で生成。OAuthトークンのDB暗号化に使用します。
NIPPOU_ENCRYPTION_KEY=

# CLI版の最終投稿先（dailyチャンネルのIncoming Webhook）
SLACK_DAILY_WEBHOOK_URL=

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback

# === Toggl (CLI版のみ。Slack版は各ユーザーが /nippou setup で設定) ===
TOGGL_API_TOKEN=

# === Slack Webhook (CLI版・旧変数。上のSLACK_DAILY_WEBHOOK_URLを優先) ===
SLACK_WEBHOOK_URL=

# === Claude (AI日報生成) ===
# auto: APIキーがあればAPI、なければローカルClaude Codeログインを使用
NIPPOU_AI_PROVIDER=api
# API利用時のみ必要。ローカルClaude Code利用時は空でよい
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CLAUDE_CODE_MODEL=claude-sonnet-4-6
NIPPOU_CLAUDE_CLI_PATH=/Users/your-name/.local/bin/claude
CLAUDE_CLI_TIMEOUT_MS=120000
NIPPOU_AI_PRESET=concise
# カスタムGemの指示を移したファイル（config/claude-instructions.example.mdを参照）
NIPPOU_AI_INSTRUCTIONS_FILE=./config/claude-instructions.md

# === Server ===
PORT=3000
APP_URL=https://your-domain.com

# === Daily automation ===
NIPPOU_TIMEZONE=Asia/Tokyo
NIPPOU_POSTS_DIR=./store/posts
